APP_NAME=t.
APP_BUNDLE_ID=$(BUNDLE_ID)
APP_SPECIFIC_URL_SCHEME=$(APP_URL_SCHEME)

GLOBAL_CONSTANTS = APP_CONFIG_IS_INTERNAL_BUILD=false APP_CONFIG_IS_APPSTORE_BUILD=true APP_CONFIG_APPSTORE_ID=$(ASC_APP_ID) APP_SPECIFIC_URL_SCHEME="\"$(APP_SPECIFIC_URL_SCHEME)\""
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) $(GLOBAL_CONSTANTS)

GCC_PREPROCESSOR_DEFINITIONS = $(inherited) APP_CONFIG_API_ID=$(APP_ID) APP_CONFIG_API_HASH="\"$(APP_HASH)\"" APP_CONFIG_HOCKEYAPP_ID="\"\""
